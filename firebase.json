{
  "hosting": {
    
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": {
    "source": "functions",
    
    "runtime": "nodejs20",
    
    "env": {
      "FIRESTORE_DATABASE_ID": "banco-de-dados-gerenciador-de-tarefas"
    }
  }
}